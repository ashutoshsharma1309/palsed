GROQ_API_KEY=
CORS_ALLOW_ALL=
CLIENT_ORIGIN=

# ---- MySQL database (PrepNext) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prepnext_app
DB_PASSWORD=
DB_NAME=prepnext

# Prisma connection strings (URL-encode special chars in the password)
DATABASE_URL="mysql://prepnext_app:PASSWORD@127.0.0.1:3306/prepnext"
SHADOW_DATABASE_URL="mysql://prepnext_app:PASSWORD@127.0.0.1:3306/prepnext_shadow"

# ---- Auth (JWT) ----
JWT_SECRET=generate-with-node-crypto-randomBytes
JWT_EXPIRES_IN=7d
