GROQ_API_KEY=
CORS_ALLOW_ALL=
CLIENT_ORIGIN=

# ──────────────────────────────────────────────────────────────────────────
#  Supabase Postgres
# ──────────────────────────────────────────────────────────────────────────
# Get both URLs from:  Supabase project → Project Settings → Database
# (you'll see "Connection string" with multiple tabs)
#
# DATABASE_URL  → "Transaction" pooler (port 6543). Used for every runtime
#                 query. PgBouncer-friendly. REQUIRED for Vercel serverless.
# DIRECT_URL    → "Direct connection" (port 5432). Used by `prisma migrate`.
#                 PgBouncer transaction mode cannot run DDL, so migrations
#                 must bypass the pooler.
#
# Replace [PROJECT-REF] with your project ref and [PASSWORD] with the DB
# password (URL-encode special chars). Replace [REGION] with your region's
# pooler hostname (e.g. "aws-0-ap-south-1").
#
# Tip: include `?pgbouncer=true&connection_limit=1` on DATABASE_URL when
# deploying to Vercel — it keeps each lambda's pool tiny so you don't
# exhaust the pooler's connection budget.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────────────────────
#  Auth (JWT)
# ──────────────────────────────────────────────────────────────────────────
# REQUIRED in production (server will refuse to boot without it).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
