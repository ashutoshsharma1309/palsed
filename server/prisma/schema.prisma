// PrepNext — relational schema for PostgreSQL (Supabase).
// Migrated from MySQL/MariaDB. JSON columns become PG `jsonb` automatically.
// Deeply-nested AI-generated payloads (lesson explanations, roadmap stages)
// stay as JSON; the relational structure around them is normalized to 3NF
// with FKs + indexes.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in prisma.config.ts (not here).
datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Style {
  visual
  code_first
  analogy
  step_by_step
}

enum Level {
  Beginner
  Intermediate
  Advanced
}

enum LessonStatus {
  in_progress
  complete
}

enum SRSKind {
  concept
  dsa
  quiz
}

enum TutorRole {
  user
  assistant
}

enum DsaStatus {
  todo
  attempted
  solved
}

// ---------- account / profile ----------

model User {
  id             String   @id @default(cuid())
  authId         String?  @unique  // Supabase auth.users.id (UUID) — links to Supabase Auth
  email          String   @unique
  passwordHash   String?  // legacy (custom JWT signups); null for Supabase-authed users
  displayName    String   @default("Learner")
  avatarSeed     String   @default("")
  learningGoal   String   @default("Master DSA")
  preferredStyle Style    @default(step_by_step)
  dailyMinutes   Int      @default(30)
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Profile-setup fields — captured after Google sign-in via /onboarding.
  // profileComplete drives the route gate: false → bounce to /onboarding.
  profileComplete Boolean  @default(false)
  fullName        String?
  collegeName     String?
  branch          String?  // CSE | IT | ECE | EE | EEE | ME | Civil | Chemical | Biotech | MCA | MBA | Other
  yearOfStudy     Int?     // 1 | 2 | 3 | 4 | 5
  graduationYear  Int?
  cgpa            Float?
  phoneNumber     String?
  linkedinUrl     String?
  githubUrl       String?
  targetRoles     String[] @default([])  // e.g. ["SDE", "Data", "ML", "Product", "Design"]

  courses        Course[]
  lessonProgress LessonProgress[]
  roadmaps       Roadmap[]
  masteryEntries MasteryEntry[]
  srsItems       SRSItem[]
  certificates   Certificate[]
  tutorThreads   TutorThread[]
  engagementDays EngagementDay[]
  interventions  EngagementIntervention[]
  dsaStatuses    DsaProblemStatus[]
  dsaBookmarks   DsaBookmark[]
  dsaAttempts    DsaAttempt[]
  notes          Note[]
  notifications  Notification[]
  progress       UserProgress?
}

// ---------- courses (course -> chapters -> lessons) ----------

model Course {
  id                      String   @id @default(cuid())
  userId                  String
  externalId              String // client-generated course id
  title                   String
  description             String
  level                   Level    @default(Beginner)
  estimatedHours          Int      @default(0)
  prerequisites           Json // string[]
  finalQuizTopics         Json // string[]
  certificatePassingScore Float    @default(0.7)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([userId, externalId])
  @@index([userId])
}

model Chapter {
  id            String @id @default(cuid())
  courseId      String
  externalId    String
  title         String
  summary       String
  position      Int    @default(0)
  masteryTopics Json // string[]

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id               String @id @default(cuid())
  chapterId        String
  externalId       String
  title            String
  difficulty       Int    @default(1) // 1..5
  estimatedMinutes Int    @default(0)
  position         Int    @default(0)
  explanations     Json // { visual, code_first, analogy, step_by_step }
  checkQuestions   Json // CheckQuestion[]

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model LessonProgress {
  id                String       @id @default(cuid())
  userId            String
  courseExternalId  String
  lessonExternalId  String
  status            LessonStatus @default(in_progress)
  score             Float?
  attempts          Int          @default(0)
  masteryScore      Float?
  msSpent           Int          @default(0)
  preferredStyle    Style?
  extraExplanations Json? // Array<{ style, markdown, at }>
  lastAt            DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonExternalId])
  @@index([userId])
  @@index([userId, courseExternalId])
}

// ---------- roadmaps ----------

model Roadmap {
  id             String   @id @default(cuid())
  userId         String
  externalId     String
  title          String
  description    String
  stages         Json // AIRoadmap.stages[]
  tools          Json // AIRoadmap.tools[]
  certifications Json // AIRoadmap.certifications[]
  careerPath     Json // AIRoadmap.career_path
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId])
}

// ---------- mastery (EWMA per topic) ----------

model MasteryEntry {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  score         Float    @default(0)
  samples       Int      @default(0)
  lastUpdatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId])
}

// ---------- spaced repetition (SM-2 lite) ----------

model SRSItem {
  id             String    @id @default(cuid())
  userId         String
  itemId         String
  kind           SRSKind
  payload        Json?
  dueAt          DateTime
  easeFactor     Float     @default(2.5)
  interval       Int       @default(1)
  reps           Int       @default(0)
  lastReviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, kind])
  @@index([userId])
  @@index([userId, dueAt])
}

// ---------- certificates ----------

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  externalId       String
  courseExternalId String
  courseTitle      String
  displayName      String
  score            Float
  verifyCode       String   @unique
  issuedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- AI tutor (thread -> messages) ----------

model TutorThread {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  title      String   @default("New chat")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@unique([userId, externalId])
  @@index([userId])
}

model TutorMessage {
  id        String    @id @default(cuid())
  threadId  String
  role      TutorRole
  content   String
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  thread TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// ---------- engagement analytics ----------

model EngagementDay {
  id            String @id @default(cuid())
  userId        String
  date          String // YYYY-MM-DD
  activeMs      Int    @default(0)
  interventions Int    @default(0)
  routes        Json // Record<route, ms>

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model EngagementIntervention {
  id     String   @id @default(cuid())
  userId String
  at     DateTime @default(now())
  route  String
  action String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- DSA practice tracker ----------

model DsaProblemStatus {
  id        String    @id @default(cuid())
  userId    String
  problemId Int
  status    DsaStatus @default(todo)
  updatedAt DateTime  @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

model DsaBookmark {
  id        String   @id @default(cuid())
  userId    String
  problemId Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

model DsaAttempt {
  id        String   @id @default(cuid())
  userId    String
  problemId Int
  count     Int      @default(0)
  msSpent   Int      @default(0)
  hintsUsed Int      @default(0)
  lastAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

// ---------- notes & notifications ----------

model Note {
  id        String   @id @default(cuid())
  userId    String
  refKey    String // lesson/problem/course id this note is attached to
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, refKey])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
}

// ---------- Vision 3.0 — durable client-progress sync ----------
//
// One JSON blob per user, mirroring exactly what the client's
// exportUserData()/importUserData() (client/src/hooks/useLocalStorageState.ts)
// already produce/consume: a Record<LS_KEYS base key, value> snapshot of every
// per-user localStorage collection (DSA checklist/solved/streak, lesson
// checklist state, quiz results, mastery, SRS, notes, etc). Deliberately a
// single flexible blob rather than one table per feature: localStorage is
// already the schema-of-record client-side, this is just its durable mirror —
// splitting it into typed tables would mean keeping two schemas in lockstep
// for every future LS_KEYS addition, for no query benefit (nothing here is
// ever queried server-side, only fetched whole per-user and merged client-side).
model UserProgress {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
