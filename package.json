{
  "name": "prepplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cd server && node index.js",
    "dev:client": "wait-on file:./.ports.json && cd client && npm run dev",
    "install:all": "npm install && (cd client && npm install)",
    "build": "(cd client && npm install --include=dev && npm run build)",
    "start": "NODE_ENV=production node server/index.js",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "groq-sdk": "^0.9.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^7.8.0",
    "wait-on": "^8.0.1"
  }
}
